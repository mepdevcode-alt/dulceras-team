# Copiá este archivo a .env y completá los valores

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Opción A: PostgreSQL via DATABASE_URL (para Docker/Render)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Opción B: SQL Server local (para dev sin Docker)
# DB_NAME=dulceras_db
# DB_HOST=localhost
# DB_PORT=1433

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
# URL pública para recibir webhooks de MP. En producción: https://tudominio.com/api/public/dulceras-team/webhooks/mp/
# Vacío = se construye dinámicamente con la URL de la request (comportamiento por defecto).
MP_WEBHOOK_URL=

# --- Email (opcional, vacío = consola) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@dulcerasteam.com

# --- n8n (opcional, vacío = emails enviados por Django) ---
# n8n debe correr local en el server (127.0.0.1), nunca expuesto a internet
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET_HEADER=X-Webhook-Secret
N8N_TIMEOUT=5
N8N_ASYNC=True
# URL con la que n8n llama de vuelta a Django (vacío = FRONTEND_URL)
N8N_CALLBACK_BASE_URL=
